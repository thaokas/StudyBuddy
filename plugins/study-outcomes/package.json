{
  "name": "@studybuddy/study-outcomes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StudyBuddy outcomes, milestones and feedback",
  "exports": {
    ".": "./host/index.mjs",
    "./client": "./client/client.js"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
