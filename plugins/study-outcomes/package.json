  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1"
  }
