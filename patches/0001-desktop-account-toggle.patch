@@ -73,3 +73,14 @@ export interface WelcomeAuthentication {
 export function needsWelcome(authentication: WelcomeAuthentication): boolean {
   return !authentication.loggedIn && !authentication.hasApiKey
 }
+
+/**
+ * Resolve whether the deployment offers DeepSeek account onboarding.
+ * @param value - DSH_DESKTOP_ACCOUNT_ENABLED; omitted preserves the standard shell.
+ * @returns false for an API-only deployment, which enters the workspace without native account onboarding.
+ */
+export function desktopAccountEnabled(value: string | undefined): boolean {
+  if (value === undefined || value === '1') return true
+  if (value === '0') return false
+  throw new Error('DSH_DESKTOP_ACCOUNT_ENABLED must be 0 or 1')
+}
