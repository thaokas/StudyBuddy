+++ b/apps/desktop/tests/account-policy.spec.ts
@@ -0,0 +1,10 @@
+/** Deployment policy for shells that use API credentials without account onboarding. */
+import { expect, it } from 'vitest'
+import { desktopAccountEnabled } from '../src/welcome-api.ts'
+
+it('keeps account onboarding by default and permits an explicit API-only deployment', () => {
+  expect(desktopAccountEnabled(undefined)).toBe(true)
+  expect(desktopAccountEnabled('1')).toBe(true)
+  expect(desktopAccountEnabled('0')).toBe(false)
+  expect(() => desktopAccountEnabled('false')).toThrow('DSH_DESKTOP_ACCOUNT_ENABLED')
+})
